# Copy to .secrets and fill in all four values. Never commit .secrets.
# This file uses Bash syntax; quote values and do not add spaces around '='.
IPINFO_KEY=''
IP2_KEY=''
PROXY_KEY=''
SPAMHAUS_KEY=''
# Optional: enable IPQualityScore reputation and fraud scoring.
IPQS_KEY=''
# Passkey browser origin and relying-party ID. Use your exact HTTPS hostname
# in production. localhost is supported for SSH tunnels and local development.
WEBAUTHN_RP_ID='localhost'
WEBAUTHN_ORIGIN='http://localhost:8080'
# Optional Fernet key. If blank, a private data/auth.key is generated on startup.
AUTH_ENCRYPTION_KEY=''
