# Copy to .env in the same directory as compose.yaml. Keep your working .env local.
# These defaults suit http://localhost:8080 accessed locally or by SSH tunnel.
# API keys/passkey settings belong in .secrets; SMTP settings in .mail_secrets.

# Additional browser-facing hostnames, comma-separated; no scheme, port or path.
# localhost and loopback addresses are already allowed by the application.
IP_CHECKER_ALLOWED_HOSTS=

# 0 for local HTTP/SSH access; set 1 when using an HTTPS reverse proxy.
IP_CHECKER_SECURE_COOKIE=0

# Optional: exact backend-facing reverse-proxy IPs or dedicated proxy CIDRs.
# Leave empty for direct access. Never trust every address.
IP_CHECKER_TRUSTED_PROXIES=

# HTTPS example: edit the active values above, do not create duplicate entries.
# IP_CHECKER_ALLOWED_HOSTS=checker.example.com
# IP_CHECKER_SECURE_COOKIE=1
# IP_CHECKER_TRUSTED_PROXIES=192.0.2.10/32
# Use your own hostname and verified proxy address in your LOCAL .env only.

# Optional Docker account IDs. The documented LOCAL_UID/LOCAL_GID command prefix
# supplies your actual IDs; it overrides .env values for that command.
# To persist them instead, run "id -u" and "id -g" and uncomment with your results.
# LOCAL_UID=1000
# LOCAL_GID=1000
