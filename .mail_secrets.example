# Copy to .mail_secrets. Never commit actual SMTP credentials.
# Set an exact browser origin: https://checker.example.com or http://localhost:8080.
APP_URL='http://localhost:8080'
SMTP_HOST=''
SMTP_PORT='587'
SMTP_SECURITY='starttls' # starttls or ssl; certificate verification is mandatory
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM=''
